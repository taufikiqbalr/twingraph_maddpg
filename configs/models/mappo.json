{
  "schema_version": 1,
  "model_id": "mappo",
  "results_policy_id": "mappo",
  "label": "MAPPO",
  "purpose": "Selected documented settings for the JCCE experiments; descriptive records, not an executable trainer configuration.",
  "learning": {
    "hidden_dim": 96,
    "minibatch_size": 16,
    "update_epochs": 12,
    "gamma": 0.96,
    "team_reward_weight": 0.65,
    "actor_lr": 0.0003,
    "critic_lr": 0.0007,
    "gae_lambda": 0.92,
    "clip_ratio": 0.2,
    "entropy_coef": 0.006,
    "value_coef": 0.7,
    "max_grad_norm": 0.75,
    "rollout_steps_per_update": 80,
    "target_update": null
  },
  "architecture": {
    "actor": {
      "hidden_layers": [
        96,
        96
      ],
      "activation": "ReLU",
      "output_logits_per_candidate": 7,
      "shared_across_agents": true
    },
    "critic": {
      "hidden_layers": [
        96,
        96
      ],
      "activation": "ReLU",
      "scalar_output": true,
      "type": "centralized state-value critic"
    }
  },
  "optimizer": {
    "name": "Adam",
    "betas": [
      0.9,
      0.999
    ],
    "epsilon": 1e-08,
    "weight_decay": 0.0
  },
  "release_limitations": [
    "The trainer, simulator, model implementations, weights and complete internal configuration are not included."
  ]
}
