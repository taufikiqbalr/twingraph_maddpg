{
  "schema_version": 1,
  "model_id": "centralized_ddqn",
  "results_policy_id": "jcce_centralized_ddqn",
  "label": "Centralized DDQN",
  "purpose": "Selected documented settings for the JCCE experiments; descriptive records, not an executable trainer configuration.",
  "learning": {
    "hidden_dim": 160,
    "batch_size": 64,
    "updates_per_step": 2,
    "gamma": 0.97,
    "tau": 0.02,
    "reward_scale": 0.078,
    "learning_rate": 0.0003,
    "replay_capacity": 12000,
    "max_grad_norm": 0.8,
    "target_update": {
      "rule": "target <- (1 - tau) * target + tau * online",
      "tau": 0.02,
      "frequency": "every learner update"
    },
    "replay_unit": "joint environment transition",
    "epsilon_initial": 0.25,
    "epsilon_decay_per_episode": 0.995,
    "epsilon_minimum": 0.03
  },
  "architecture": {
    "q_network": {
      "shared_trunk_hidden_layers": [
        160,
        160
      ],
      "activation": "ReLU",
      "scalar_value_head": true,
      "branch_count_formula": "8 * number_of_agents",
      "actions_per_branch": 7,
      "type": "centralized branching dueling Double DQN"
    }
  },
  "optimizer": {
    "name": "Adam",
    "betas": [
      0.9,
      0.999
    ],
    "epsilon": 1e-08,
    "weight_decay": 0.0
  },
  "release_limitations": [
    "The trainer, simulator, model implementations, weights and complete internal configuration are not included."
  ]
}
